{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: Check active host file",
      "type": "process",
      "command": "/usr/bin/clang",
      "args": ["-std=c11", "-Wall", "-Wextra", "-fsyntax-only", "${file}"],
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "C: Check active STM32 file",
      "type": "process",
      "command": "/opt/homebrew/bin/arm-none-eabi-gcc",
      "args": [
        "-std=c11", "-Wall", "-Wextra", "-mcpu=cortex-m4", "-mthumb",
        "-ffreestanding", "-fno-builtin", "-fsyntax-only", "${file}"
      ],
      "problemMatcher": ["$gcc"],
      "group": "build"
    }
  ]
}
