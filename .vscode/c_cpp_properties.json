{
    "configurations": [
        {
            "name": "Mac",
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c11",
            "intelliSenseMode": "macos-clang-arm64",
            "includePath": [
                "${workspaceFolder}/firmware/host/**"
            ],
            "compilerArgs": [
                "-Wall",
                "-Wextra"
            ]
        },
        {
            "name": "STM32 Cortex-M4",
            "compilerPath": "/opt/homebrew/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "intelliSenseMode": "gcc-arm",
            "includePath": [
                "${workspaceFolder}/firmware/stm32/**"
            ],
            "compilerArgs": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-ffreestanding",
                "-fno-builtin",
                "-Wall",
                "-Wextra"
            ]
        },
        {
            "name": "mac",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c17",
            "cppStandard": "c++14",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}